{
  "name": "@mandate-gate/gateway",
  "private": true,
  "type": "module",
  "description": "MandateGate: the customer's MCP gateway that verifies agent, mandate and approval before acting",
  "main": "src/gateway.ts",
  "exports": {
    ".": "./src/gateway.ts",
    "./agents": "./src/agents.ts",
    "./mandates": "./src/mandates.ts",
    "./approvals": "./src/approvals.ts",
    "./verifier": "./src/verifier.ts",
    "./anchorer": "./src/anchorer.ts",
    "./txqueue": "./src/txqueue.ts",
    "./run": "./src/run.ts"
  },
  "scripts": {
    "start": "node web/build.mjs && tsx src/main.ts",
    "test": "tsx --test test/*.test.ts",
    "build:web": "node web/build.mjs",
    "verify-audit": "tsx scripts/verify-audit.ts",
    "demo:up": "tsx scripts/demo-up.ts"
  },
  "dependencies": {
    "@concordium/browser-wallet-api-helpers": "3.3.0",
    "@concordium/web-sdk": "12.0.3",
    "@grpc/grpc-js": "^1.14.7",
    "@mandate-gate/core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@x402/concordium": "2.32.0",
    "@x402/core": "2.32.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@mandate-gate/agent-proxy": "workspace:*",
    "@mandate-gate/mock-ops": "workspace:*",
    "esbuild": "0.25.12",
    "viem": "^2.58.4"
  }
}
